   "end": 239.06,
   "text": "做一个初始化"
  },
  {
   "id": 116,
   "start": 239.06,
   "end": 240.9,
   "text": "这个前面都讲过了"
  },
  {
   "id": 117,
   "start": 240.9,
   "end": 242.36,
   "text": "那么接下来呢"
  },
  {
   "id": 118,
   "start": 242.36,
   "end": 243.6,
   "text": "就是说我们要"
  },
  {
   "id": 119,
   "start": 243.6,
   "end": 245.46,
   "text": "从start这个函数呢"
  },
  {
   "id": 120,
